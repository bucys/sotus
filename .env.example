# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (sotus-dev project, Frankfurt)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Gemini (server only, billing enabled)
GEMINI_API_KEY=
GEMINI_MODEL=

# Recipe publish signing secret (server only). 32 random bytes as hex: openssl rand -hex 32
# Must match the Supabase Vault secret named recipe_publish_secret.
RECIPE_PUBLISH_SECRET=
